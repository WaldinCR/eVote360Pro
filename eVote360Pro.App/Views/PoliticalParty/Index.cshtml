@model List<eVote360Pro.Core.Application.ViewModels.PoliticalParty.PoliticalPartyViewModel>
@inject eVote360Pro.Core.Application.Interfaces.IElectionService ElectionService
@inject eVote360Pro.Core.Domain.Interfaces.Repositories.ICandidateRepository CandidateRepository

@{
    ViewData["Title"] = "Partidos Políticos";
    var elections = await ElectionService.GetAllAsync();
    var isElectionActive = elections.Any(e => e.Status == eVote360Pro.Core.Domain.Common.Enums.ElectionStatus.Active);
    var candidates = await CandidateRepository.GetAllAsync();
}

<div class="atop">
    <p class="aptitle"><i class="ti ti-flag"></i> Partidos Políticos</p>
    @if (!isElectionActive)
    {
        <a href="@Url.Action("Create", "PoliticalParty")" class="bnew" style="text-decoration: none;">
            <i class="ti ti-plus"></i> Nuevo partido
        </a>
    }
    else
    {
        <button class="bnew" disabled style="opacity: 0.5; cursor: not-allowed;" title="Acciones bloqueadas: Existe una elección activa.">
            <i class="ti ti-plus"></i> Nuevo partido
        </button>
    }
</div>

@if (isElectionActive)
{
    <partial name="_BloqueoEleccionActiva" />
}

<div class="fb">
    <input class="finp" type="text" placeholder="Buscar partido..." style="width:200px" id="partySearch">
    <select class="fsel" id="statusFilter">
        <option value="">Todos</option>
        <option value="Activo">Activos</option>
        <option value="Inactivo">Inactivos</option>
    </select>
</div>

<div class="tw">
    <table class="dt" id="partiesTable">
        <thead>
            <tr>
                <th style="width:12%">Logo</th>
                <th style="width:30%">Nombre</th>
                <th style="width:12%">Siglas</th>
                <th style="width:12%">Estado</th>
                <th style="width:14%">Restricciones</th>
                <th style="width:20%">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    var hasParticipated = candidates.Any(c => c.PoliticalPartyId == item.Id && c.ParticipatedInElection);

                    <tr data-name="@($"{item.Name} {item.Acronym}".ToLower())" data-status="@(item.IsActive ? "Activo" : "Inactivo")">
                        <td>
                            @if (!string.IsNullOrEmpty(item.LogoUrl))
                            {
                                <img src="@item.LogoUrl" alt="Logo" style="width:32px; height:32px; object-fit:contain; border-radius:6px;" />
                            }
                            else
                            {
                                <div style="width:32px;height:32px;background:var(--b50);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--b800)">
                                    @(item.Acronym.Length >= 2 ? item.Acronym.Substring(0, 2).ToUpper() : item.Acronym.ToUpper())
                                </div>
                            }
                        </td>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Acronym</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="bdg bact">Activo</span>
                            }
                            else
                            {
                                <span class="bdg binact">Inactivo</span>
                            }
                        </td>
                        <td>
                            @if (hasParticipated)
                            {
                                <span style="font-size:11px;color:var(--r800)"><i class="ti ti-lock" style="font-size:10px"></i> Bloqueado</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>
                            @if (isElectionActive)
                            {
                                <button class="bsm gray" disabled style="opacity: 0.5; cursor: not-allowed;"><i class="ti ti-edit"></i> Editar</button>
                                @if (item.IsActive)
                                {
                                    <button class="bsm red" disabled style="opacity: 0.5; cursor: not-allowed;">Inactivar</button>
                                }
                                else
                                {
                                    <button class="bsm green" disabled style="opacity: 0.5; cursor: not-allowed;">Activar</button>
                                }
                            }
                            else
                            {
                                <a href="@Url.Action("Edit", "PoliticalParty", new { id = item.Id })" class="bsm gray"><i class="ti ti-edit"></i> Editar</a>
                                <form method="post" action="@Url.Action("ChangeStatus", "PoliticalParty", new { id = item.Id })" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    @if (item.IsActive)
                                    {
                                        <button type="submit" class="bsm red" onclick="return confirm('¿Está seguro de inactivar este partido?');">Inactivar</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="bsm green" onclick="return confirm('¿Está seguro de activar este partido?');">Activar</button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" style="text-align: center; color: var(--gy400);">No hay partidos registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.getElementById('partySearch').addEventListener('input', filterTable);
        document.getElementById('statusFilter').addEventListener('change', filterTable);

        function filterTable() {
            var searchVal = document.getElementById('partySearch').value.toLowerCase();
            var statusVal = document.getElementById('statusFilter').value;
            var rows = document.querySelectorAll('#partiesTable tbody tr');

            rows.forEach(function(row) {
                var name = row.getAttribute('data-name');
                var status = row.getAttribute('data-status');

                var nameMatch = !name || name.indexOf(searchVal) > -1;
                var statusMatch = !statusVal || status === statusVal;

                if (nameMatch && statusMatch) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
}
