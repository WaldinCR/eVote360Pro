@model List<eVote360Pro.Core.Application.ViewModels.PoliticalParty.PoliticalPartyViewModel>
@{
    ViewData["Title"] = "Gestión de Partidos Políticos";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 text-dark fw-bold mb-1"><i class="bi bi-flag-fill text-primary"></i> Partidos Políticos</h1>
            <p class="text-muted mb-0">Administra los partidos políticos que participan en la contienda electoral.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i> Nuevo Partido
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-info-circle text-muted display-4 mb-3"></i>
                <h4 class="text-secondary fw-semibold">No hay partidos registrados</h4>
                <p class="text-muted">Comienza registrando tu primer partido político utilizando el botón superior.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var party in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm transition-hover">
                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="party-logo-wrapper me-3 bg-light rounded shadow-sm border p-1" style="width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                    @if (!string.IsNullOrEmpty(party.LogoUrl))
                                    {
                                        <img src="@party.LogoUrl" alt="Logo de @party.Name" class="img-fluid rounded" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-image text-muted fs-2"></i>
                                    }
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <h5 class="card-title fw-bold text-dark mb-0 text-truncate">@party.Name</h5>
                                    <span class="badge bg-secondary-subtle text-secondary fw-bold px-2.5 py-1">@party.Acronym</span>
                                </div>
                            </div>
                            
                            <p class="card-text text-muted mb-4 flex-grow-1 text-clamp-3">
                                @(string.IsNullOrEmpty(party.Description) ? "Sin descripción proporcionada." : party.Description)
                            </p>
                            
                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    @if (party.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold px-2.5 py-1">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold px-2.5 py-1">Inactivo</span>
                                    }
                                </div>
                                
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@party.Id" class="btn btn-outline-secondary btn-sm rounded" title="Editar partido">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    
                                    <form asp-action="ChangeStatus" asp-route-id="@party.Id" method="post" class="d-inline">
                                        @if (party.IsActive)
                                        {
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded" title="Desactivar partido">
                                                <i class="bi bi-x-circle"></i> Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-success btn-sm rounded" title="Activar partido">
                                                <i class="bi bi-check-circle"></i> Activar
                                            </button>
                                        }
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1) !important;
    }
    .text-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
