@model eVote360Pro.Core.Application.ViewModels.User.SaveUserViewModel
@using eVote360Pro.Core.Domain.Common.Enums

@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="atop">
    <p class="aptitle"><i class="ti ti-plus"></i> Nuevo Usuario</p>
    <a href="@Url.Action("Index", "User")" class="bo"><i class="ti ti-arrow-left"></i> Volver</a>
</div>

<div class="form-section" style="max-width: 600px; margin: 0 auto;">
    <p class="form-section-title"><i class="ti ti-edit"></i> Datos del usuario</p>
    
    <form method="post" action="@Url.Action("Create", "User")">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="ae" style="margin-bottom: 1rem;"></div>

        <div class="row2">
            <div class="fw">
                <label asp-for="Name" class="fl">Nombre <span class="req">*</span></label>
                <input asp-for="Name" class="fi" type="text" placeholder="Ej. Juan" required />
                <span asp-validation-for="Name" style="font-size: 11px; color: var(--r400);"></span>
            </div>
            <div class="fw">
                <label asp-for="LastName" class="fl">Apellido <span class="req">*</span></label>
                <input asp-for="LastName" class="fi" type="text" placeholder="Ej. Pérez" required />
                <span asp-validation-for="LastName" style="font-size: 11px; color: var(--r400);"></span>
            </div>
        </div>

        <div class="row2">
            <div class="fw">
                <label asp-for="UserName" class="fl">Nombre de Usuario <span class="req">*</span></label>
                <input asp-for="UserName" class="fi" type="text" placeholder="Ej. jperez" required />
                <span asp-validation-for="UserName" style="font-size: 11px; color: var(--r400);"></span>
            </div>
            <div class="fw">
                <label asp-for="Email" class="fl">Correo Electrónico <span class="req">*</span></label>
                <input asp-for="Email" class="fi" type="email" placeholder="Ej. jperez@evote.do" required />
                <span asp-validation-for="Email" style="font-size: 11px; color: var(--r400);"></span>
            </div>
        </div>

        <div class="row2">
            <div class="fw">
                <label asp-for="Password" class="fl">Contraseña <span class="req">*</span></label>
                <input asp-for="Password" class="fi" type="password" placeholder="••••••••" required />
                <span asp-validation-for="Password" style="font-size: 11px; color: var(--r400);"></span>
            </div>
            <div class="fw">
                <label asp-for="ConfirmPassword" class="fl">Confirmar Contraseña <span class="req">*</span></label>
                <input asp-for="ConfirmPassword" class="fi" type="password" placeholder="••••••••" required />
                <span asp-validation-for="ConfirmPassword" style="font-size: 11px; color: var(--r400);"></span>
            </div>
        </div>

        <div class="fw">
            <label asp-for="Role" class="fl">Rol <span class="req">*</span></label>
            <select asp-for="Role" class="fi" required>
                <option value="">Seleccione un rol</option>
                <option value="@((int)UserRol.Administrador)">Administrador</option>
                <option value="@((int)UserRol.DirigentePolitico)">Dirigente Político</option>
            </select>
            <span asp-validation-for="Role" style="font-size: 11px; color: var(--r400);"></span>
        </div>

        <input type="hidden" asp-for="IsActive" value="true" />

        <div style="display:flex; gap:8px; margin-top:1.5rem">
            <button type="submit" class="fbtn" style="border: none; cursor: pointer; padding: 9px 18px; font-weight: 600; border-radius: var(--rmd); background: var(--g800); color: #fff; display: inline-flex; align-items: center; gap: 5px;">
                <i class="ti ti-check"></i> Guardar
            </button>
            <a href="@Url.Action("Index", "User")" class="bo" style="text-decoration: none;">Cancelar</a>
        </div>
    </form>
</div>
