@model eVote360Pro.Core.Application.ViewModels.Admin.AdminHomeViewModel
@{
    ViewData["Title"] = "Panel de Control Electoral";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 text-dark fw-bold mb-1"><i class="bi bi-shield-check text-primary"></i> Panel de Control</h1>
            <p class="text-muted mb-0">Resumen general del estado del sistema de votación y las elecciones.</p>
        </div>
        
        <!-- Filtro de Año -->
        <form method="get" class="d-flex align-items-center gap-2">
            <label for="year" class="fw-semibold text-secondary text-nowrap mb-0">Año Electoral:</label>
            <select name="year" id="year" class="form-select shadow-sm" onchange="this.form.submit()">
                @if (Model.AvailableYears == null || !Model.AvailableYears.Any())
                {
                    <option value="@DateTime.Now.Year">@DateTime.Now.Year</option>
                }
                else
                {
                    foreach (var y in Model.AvailableYears)
                    {
                        <!option value="@y" @(y == Model.SelectedYear ? "selected" : "")>@y</!option>
                    }
                }
            </select>
        </form>
    </div>

    <!-- Cards de Métricas -->
    <div class="row g-4 mb-4">
        <!-- Partidos -->
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm bg-primary text-white h-100 rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 fw-semibold text-uppercase mb-1 small">Total Partidos</h6>
                            <h2 class="fw-bold mb-0">@Model.TotalParties</h2>
                        </div>
                        <i class="bi bi-flag-fill fs-1 opacity-50"></i>
                    </div>
                    <div class="mt-3 pt-2 border-top border-white-10 d-flex justify-content-between text-white-50 small">
                        <span>Activos: <strong>@Model.ActiveParties</strong></span>
                        <span>Inactivos: <strong>@Model.InactiveParties</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Candidatos -->
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm bg-success text-white h-100 rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 fw-semibold text-uppercase mb-1 small">Candidatos</h6>
                            <h2 class="fw-bold mb-0">@Model.TotalCandidates</h2>
                        </div>
                        <i class="bi bi-people-fill fs-1 opacity-50"></i>
                    </div>
                    <div class="mt-3 pt-2 border-top border-white-10 text-white-50 small">
                        <span>Candidatos Activos: <strong>@Model.ActiveCandidates</strong></span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Puestos Electivos (Estático por diseño) -->
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm bg-info text-white h-100 rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 fw-semibold text-uppercase mb-1 small">Módulos Administrativos</h6>
                            <h4 class="fw-bold mb-0 mt-1">Configurados</h4>
                        </div>
                        <i class="bi bi-list-task fs-1 opacity-50"></i>
                    </div>
                    <div class="mt-3 pt-2 border-top border-white-10 text-white-50 small">
                        <span>Acceso completo a configuración electoral</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fecha/Hora -->
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm bg-dark text-white h-100 rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 fw-semibold text-uppercase mb-1 small">Fecha del Servidor</h6>
                            <h5 class="fw-bold mb-0 mt-1">@DateTime.Now.ToString("dd/MM/yyyy")</h5>
                        </div>
                        <i class="bi bi-calendar3 fs-1 opacity-50"></i>
                    </div>
                    <div class="mt-3 pt-2 border-top border-white-10 text-white-50 small">
                        <span>Hora local: <strong>@DateTime.Now.ToString("HH:mm")</strong></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Resumen Electoral -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom-0">
            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-collection-play-fill text-primary me-2"></i> Resumen de Elecciones en @Model.SelectedYear</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Elections == null || !Model.Elections.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-trophy display-4 mb-2"></i>
                    <p class="mb-0">No se encontraron elecciones registradas en el año @Model.SelectedYear.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary fw-semibold">
                            <tr>
                                <th class="ps-4">Elección</th>
                                <th>Fecha de Activación</th>
                                <th>Partidos Participantes</th>
                                <th>Candidatos Postulados</th>
                                <th>Ciudadanos que Votaron</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var election in Model.Elections)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@election.ElectionName</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2.5 py-1">@election.RealizationDate</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold">@election.ParticipatingParties</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-bold">@election.RealCandidates</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-dark-subtle text-dark border border-dark-subtle px-2 py-1 fw-bold">@election.CitizensVoted</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
