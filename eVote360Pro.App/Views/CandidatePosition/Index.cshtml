@model IEnumerable<eVote360Pro.Core.Application.Dtos.CandidatePosition.CandidatePositionDto>
@{
    ViewData["Title"] = "Boleta del Partido";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold"><i class="bi bi-card-checklist text-primary me-2"></i> Asignación de Candidatos</h2>
        <p class="text-muted">Gestión de la boleta electoral del partido.</p>
    </div>
    <div class="col-md-4 text-md-end align-self-center">
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nueva Asignación
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="ps-3">Candidato</th>
                    <th>Puesto Electivo</th>
                    <th class="text-center">Tipo</th>
                    <th class="text-center pe-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            <p class="mb-0 fs-5">No hay candidatos asignados a puestos en este partido.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@item.CandidateName</td>
                            <td>@item.ElectivePositionName</td>
                            <td class="text-center">
                                @if (item.IsAllied)
                                {
                                    <span class="badge bg-info text-dark rounded-pill px-3 py-2"><i class="bi bi-diagram-3-fill me-1"></i> Aliado</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary rounded-pill px-3 py-2"><i class="bi bi-person-fill me-1"></i> Propio</span>
                                }
                            </td>
                            <td class="text-center pe-3">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de que deseas eliminar esta asignación de la boleta?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar Asignación">
                                        <i class="bi bi-trash-fill"></i> Eliminar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>