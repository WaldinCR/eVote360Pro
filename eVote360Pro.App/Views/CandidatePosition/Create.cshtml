@model eVote360Pro.Core.Application.ViewModels.CandidatePosition.SaveCandidatePositionViewModel
@{
    ViewData["Title"] = "Asignar Candidato";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-person-check"></i> Asignar Candidato a Puesto</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    
                    <div class="mb-3">
                        <label asp-for="CandidateId" class="form-label fw-bold"></label>
                        <select asp-for="CandidateId" class="form-select">
                            <option value="">-- Seleccione un Candidato --</option>
                            @if (ViewBag.Candidates != null)
                            {
                                foreach (var c in ViewBag.Candidates)
                                {
                                    <option value="@c.Id">@c.Name @c.LastName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CandidateId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ElectivePositionId" class="form-label fw-bold"></label>
                        <select asp-for="ElectivePositionId" class="form-select">
                            <option value="">-- Seleccione un Puesto Electivo --</option>
                            @if (ViewBag.Positions != null)
                            {
                                foreach (var p in ViewBag.Positions)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ElectivePositionId" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar Asignación</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>