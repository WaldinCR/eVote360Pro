@model eVote360Pro.Core.Application.ViewModels.Citizen.SaveCitizenViewModel

@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Editar Ciudadano" : "Nuevo Ciudadano";
}

<div class="atop">
    <p class="aptitle"><i class="ti ti-edit"></i> @(isEdit ? "Editar Ciudadano" : "Nuevo Ciudadano")</p>
    <a href="@Url.Action("Index", "Citizen")" class="bo"><i class="ti ti-arrow-left"></i> Volver</a>
</div>

<div class="form-section" style="max-width: 600px; margin: 0 auto;">
    <p class="form-section-title"><i class="ti ti-edit"></i> Datos del ciudadano</p>
    
    <form method="post" action="@(isEdit ? Url.Action("Edit", "Citizen") : Url.Action("Create", "Citizen"))">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="HasVoted" />
        
        <div asp-validation-summary="ModelOnly" class="ae" style="margin-bottom: 1rem;"></div>

        <div class="row2">
            <div class="fw">
                <label asp-for="FirstName" class="fl">Primer Nombre <span class="req">*</span></label>
                <input asp-for="FirstName" class="fi" type="text" placeholder="Ej. Ana" required />
                <span asp-validation-for="FirstName" style="font-size: 11px; color: var(--r400);"></span>
            </div>
            <div class="fw">
                <label asp-for="LastName" class="fl">Apellido <span class="req">*</span></label>
                <input asp-for="LastName" class="fi" type="text" placeholder="Ej. López" required />
                <span asp-validation-for="LastName" style="font-size: 11px; color: var(--r400);"></span>
            </div>
        </div>

        <div class="fw">
            <label asp-for="Document" class="fl">Número de Documento (Cédula) <span class="req">*</span></label>
            @if (Model.HasVoted)
            {
                <input asp-for="Document" class="fi" type="text" readonly style="background: var(--gy50); color: var(--gy600);" />
                <p class="fhint" style="color: var(--r800);"><i class="ti ti-lock"></i> El documento no se puede editar porque este ciudadano ya ejerció su voto.</p>
            }
            else
            {
                <input asp-for="Document" class="fi" type="text" placeholder="Ej. 00112345678" required />
                <span asp-validation-for="Document" style="font-size: 11px; color: var(--r400);"></span>
                <p class="fhint">Debe ser único y tener 11 dígitos sin guiones.</p>
            }
        </div>

        <div class="fw">
            <label asp-for="Email" class="fl">Correo Electrónico <span class="req">*</span></label>
            <input asp-for="Email" class="fi" type="email" placeholder="Ej. ana@email.com" required />
            <span asp-validation-for="Email" style="font-size: 11px; color: var(--r400);"></span>
            <p class="fhint">Único. Se utilizará para el envío de códigos OTP.</p>
        </div>

        @if (!isEdit)
        {
            <input type="hidden" asp-for="IsActive" value="true" />
        }
        else
        {
            <input type="hidden" asp-for="IsActive" />
        }

        <div style="display:flex; gap:8px; margin-top:1.5rem">
            <button type="submit" class="fbtn" style="border: none; cursor: pointer; padding: 9px 18px; font-weight: 600; border-radius: var(--rmd); background: var(--g800); color: #fff; display: inline-flex; align-items: center; gap: 5px;">
                <i class="ti ti-check"></i> Guardar
            </button>
            <a href="@Url.Action("Index", "Citizen")" class="bo" style="text-decoration: none;">Cancelar</a>
        </div>
    </form>
</div>
