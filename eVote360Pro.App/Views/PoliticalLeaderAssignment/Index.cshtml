@model List<eVote360Pro.Core.Application.ViewModels.PoliticalLeaderAssignment.PoliticalLeaderAssignmentViewModel>
@{
    ViewData["Title"] = "Dirigentes Asignados";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 text-dark fw-bold mb-1"><i class="bi bi-person-lines-fill text-primary"></i> Asignación de Dirigentes</h1>
            <p class="text-muted mb-0">Asigna y gestiona la relación de dirigentes políticos con sus respectivos partidos.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-link-45deg me-2"></i> Asignar Dirigente
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-link text-muted display-4 mb-3"></i>
                    <h5 class="text-secondary fw-semibold">No hay dirigentes asignados</h5>
                    <p class="text-muted mb-0">Realiza tu primera vinculación usando el botón superior.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary fw-semibold">
                            <tr>
                                <th class="ps-4">Dirigente Político (Usuario)</th>
                                <th>Partido Político</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-medium text-dark">
                                        <i class="bi bi-person-circle text-muted me-2"></i>
                                        @item.UserName
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 fw-semibold">
                                            @item.PoliticalPartyName
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de que desea eliminar esta asignación?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded">
                                                <i class="bi bi-trash3-fill me-1"></i> Desvincular
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
