@{
    ViewData["Title"] = "Alianzas Políticas";
    var receivedPending = ViewBag.ReceivedPending as List<eVote360Pro.Core.Application.ViewModels.Alliance.AllianceRequestViewModel> ?? new List<eVote360Pro.Core.Application.ViewModels.Alliance.AllianceRequestViewModel>();
    var sentRequests = ViewBag.SentRequests as List<eVote360Pro.Core.Application.ViewModels.Alliance.AllianceRequestViewModel> ?? new List<eVote360Pro.Core.Application.ViewModels.Alliance.AllianceRequestViewModel>();
    var activeAlliances = ViewBag.ActiveAlliances as List<eVote360Pro.Core.Application.ViewModels.Alliance.AllianceViewModel> ?? new List<eVote360Pro.Core.Application.ViewModels.Alliance.AllianceViewModel>();
    int currentPartyId = Context.Session.GetInt32("PartyId") ?? 0;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 text-dark fw-bold mb-1"><i class="bi bi-diagram-3-fill text-primary"></i> Alianzas Políticas</h1>
            <p class="text-muted mb-0">Gestiona las alianzas de tu partido político con otras agrupaciones.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-2"></i> Solicitar Nueva Alianza
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Solicitudes Recibidas Pendientes -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-mailbox2 text-info me-2"></i> Solicitudes Recibidas (Pendientes)</h5>
                </div>
                <div class="card-body">
                    @if (!receivedPending.Any())
                    {
                        <p class="text-muted small text-center my-4">No tienes solicitudes de alianza pendientes de responder.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var req in receivedPending)
                            {
                                <div class="p-3 border rounded bg-light">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-bold mb-0 text-dark">@req.ApplicantPartyName</h6>
                                        <small class="text-muted">@req.RequestDate.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <div class="d-flex gap-2 justify-content-end">
                                        <form asp-action="Accept" asp-route-id="@req.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check2"></i> Aceptar</button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@req.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-x-lg"></i> Rechazar</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Solicitudes Enviadas -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-send text-primary me-2"></i> Solicitudes Enviadas</h5>
                </div>
                <div class="card-body">
                    @if (!sentRequests.Any())
                    {
                        <p class="text-muted small text-center my-4">No has enviado ninguna solicitud de alianza.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var req in sentRequests)
                            {
                                <div class="p-3 border rounded bg-light d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">@req.ReceiverPartyName</h6>
                                        <small class="text-muted">Enviado: @req.RequestDate.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (req.Status == eVote360Pro.Core.Domain.Common.Enums.AllianceRequestStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark px-2.5 py-1">Pendiente</span>
                                            <form asp-action="DeleteRequest" asp-route-id="@req.Id" method="post" onsubmit="return confirm('¿Seguro que deseas cancelar esta solicitud?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                        else if (req.Status == eVote360Pro.Core.Domain.Common.Enums.AllianceRequestStatus.Accepted)
                                        {
                                            <span class="badge bg-success px-2.5 py-1">Aceptada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-2.5 py-1">Rechazada</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Alianzas Vigentes -->
        <div class="col-12 mt-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-award text-success me-2"></i> Alianzas Vigentes</h5>
                </div>
                <div class="card-body">
                    @if (!activeAlliances.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-diagram-3 display-4 mb-2"></i>
                            <p class="mb-0">No existen alianzas vigentes para tu partido político.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Partidos en Alianza</th>
                                        <th>Fecha de Establecimiento</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var alliance in activeAlliances)
                                    {
                                        string alliedPartyName = alliance.Party1Id == currentPartyId ? alliance.Party2Name : alliance.Party1Name;
                                        <tr>
                                            <td class="fw-semibold text-dark">
                                                Mi Partido <i class="bi bi-arrow-left-right text-muted mx-2"></i> @alliedPartyName
                                            </td>
                                            <td>@alliance.CreationDate.ToString("dd/MM/yyyy")</td>
                                            <td class="text-end">
                                                <form asp-action="DeleteAlliance" asp-route-id="@alliance.Id" method="post" onsubmit="return confirm('¿Está seguro de que desea disolver esta alianza? Se validará que no haya postulados cruzados.');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                                        <i class="bi bi-trash3 me-1"></i> Disolver Alianza
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
