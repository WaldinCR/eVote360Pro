@model List<eVote360Pro.Core.Application.ViewModels.Citizen.CitizenViewModel>
@inject eVote360Pro.Core.Application.Interfaces.IElectionService ElectionService

@{
    ViewData["Title"] = "Mantenimiento de Ciudadanos";
    var elections = await ElectionService.GetAllAsync();
    var isElectionActive = elections.Any(e => e.Status == eVote360Pro.Core.Domain.Common.Enums.ElectionStatus.Active);
}

<div class="atop">
    <p class="aptitle"><i class="ti ti-users"></i> Ciudadanos</p>
    @if (!isElectionActive)
    {
        <a href="@Url.Action("Create", "Citizen")" class="bnew" style="text-decoration: none;">
            <i class="ti ti-plus"></i> Nuevo ciudadano
        </a>
    }
    else
    {
        <button class="bnew" disabled style="opacity: 0.5; cursor: not-allowed;" title="Acciones bloqueadas: Existe una elección activa.">
            <i class="ti ti-plus"></i> Nuevo ciudadano
        </button>
    }
</div>

@if (isElectionActive)
{
    <partial name="_BloqueoEleccionActiva" />
}

<div class="fb">
    <input class="finp" type="text" placeholder="Buscar por nombre o documento..." style="width:240px" id="citizenSearch">
    <select class="fsel" id="statusFilter">
        <option value="">Todos</option>
        <option value="Activo">Activos</option>
        <option value="Inactivo">Inactivos</option>
    </select>
</div>

<div class="tw">
    <table class="dt" id="citizensTable">
        <thead>
            <tr>
                <th style="width:18%">Documento</th>
                <th style="width:28%">Nombre completo</th>
                <th style="width:25%">Correo</th>
                <th style="width:10%">Estado</th>
                <th style="width:19%">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr data-name="@($"{item.FirstName} {item.LastName} {item.Document}".ToLower())" data-status="@(item.IsActive ? "Activo" : "Inactivo")">
                        <td>@item.Document</td>
                        <td><strong>@item.FirstName @item.LastName</strong></td>
                        <td>@item.Email</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="bdg bact">Activo</span>
                            }
                            else
                            {
                                <span class="bdg binact">Inactivo</span>
                            }
                        </td>
                        <td>
                            @if (isElectionActive)
                            {
                                <button class="bsm gray" disabled style="opacity: 0.5; cursor: not-allowed;"><i class="ti ti-edit"></i> Editar</button>
                                @if (item.IsActive)
                                {
                                    <button class="bsm red" disabled style="opacity: 0.5; cursor: not-allowed;">Inactivar</button>
                                }
                                else
                                {
                                    <button class="bsm green" disabled style="opacity: 0.5; cursor: not-allowed;">Activar</button>
                                }
                            }
                            else
                            {
                                <a href="@Url.Action("Edit", "Citizen", new { id = item.Id })" class="bsm gray"><i class="ti ti-edit"></i> Editar</a>
                                <a href="@Url.Action("ToggleStatus", "Citizen", new { id = item.Id })" class="bsm @(item.IsActive ? "red" : "green")">
                                    @(item.IsActive ? "Inactivar" : "Activar")
                                </a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" style="text-align: center; color: var(--gy400);">No hay ciudadanos registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="tfoot">@(Model?.Count ?? 0) ciudadanos registrados</p>

@section Scripts {
    <script>
        document.getElementById('citizenSearch').addEventListener('input', filterTable);
        document.getElementById('statusFilter').addEventListener('change', filterTable);

        function filterTable() {
            var searchVal = document.getElementById('citizenSearch').value.toLowerCase();
            var statusVal = document.getElementById('statusFilter').value;
            var rows = document.querySelectorAll('#citizensTable tbody tr');

            rows.forEach(function(row) {
                var name = row.getAttribute('data-name');
                var status = row.getAttribute('data-status');

                var nameMatch = !name || name.indexOf(searchVal) > -1;
                var statusMatch = !statusVal || status === statusVal;

                if (nameMatch && statusMatch) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
}
