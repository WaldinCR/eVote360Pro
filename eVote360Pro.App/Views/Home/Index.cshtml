@using Microsoft.AspNetCore.Http
@{
    var role = Context.Session.GetString("UserRole");
}

@if (role == "Administrador")
{
    var adminModel = Model as eVote360Pro.Core.Application.ViewModels.Admin.AdminHomeViewModel;
    <partial name="_AdminHome" model="adminModel" />
}
else if (role == "DirigentePolitico")
{
    var leaderModel = Model as eVote360Pro.Core.Application.ViewModels.Leader.LeaderHomeViewModel;
    <partial name="_LeaderHome" model="leaderModel" />
}
else
{
    Context.Response.Redirect(Url.Action("Index", "Elector", new { area = "Elector" }) ?? "/Elector");
}
