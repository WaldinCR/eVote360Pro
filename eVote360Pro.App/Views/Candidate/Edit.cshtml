@model eVote360Pro.Core.Application.ViewModels.Candidate.SaveCandidateViewModel
@inject eVote360Pro.Core.Domain.Interfaces.Repositories.ICandidateRepository CandidateRepository

@{
    ViewData["Title"] = "Editar Candidato";
    var dbCandidate = await CandidateRepository.GetByIdAsync(Model.Id);
    var participated = dbCandidate?.ParticipatedInElection ?? false;
}

<div class="atop">
    <p class="aptitle"><i class="ti ti-edit"></i> Editar Candidato</p>
    <a href="@Url.Action("Index", "Candidate")" class="bo"><i class="ti ti-arrow-left"></i> Volver</a>
</div>

<div class="form-section" style="max-width: 600px; margin: 0 auto;">
    <p class="form-section-title"><i class="ti ti-edit"></i> Datos del candidato</p>

    @if (participated)
    {
        <div class="ae" style="margin-bottom: 1.25rem;">
            <i class="ti ti-lock"></i>
            <span>Restricción activa: Este candidato ya participó en una elección. El nombre, apellido y foto no pueden ser modificados.</span>
        </div>
    }

    <form method="post" action="@Url.Action("Edit", "Candidate")" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PoliticalPartyId" />
        <input type="hidden" asp-for="IsActive" />
        <input type="hidden" asp-for="PhotoUrl" />

        <div asp-validation-summary="ModelOnly" class="ae" style="margin-bottom: 1rem;"></div>

        @if (participated)
        {
            @* Mandamos los campos reales ocultos para que el Model Binder no los reciba nulos *@
            <input type="hidden" asp-for="Name" />
            <input type="hidden" asp-for="LastName" />

            <div class="row2">
                <div class="fw">
                    <label class="fl">Nombre</label>
                    <input class="fi" type="text" value="@Model.Name" disabled style="background: var(--gy50); color: var(--gy600);" />
                </div>
                <div class="fw">
                    <label class="fl">Apellido</label>
                    <input class="fi" type="text" value="@Model.LastName" disabled style="background: var(--gy50); color: var(--gy600);" />
                </div>
            </div>

            <div class="fw" style="margin-top: 1.25rem;">
                <label class="fl">Foto del Candidato</label>
                <div style="display:flex; align-items:center; gap:15px; background:var(--gy50); border:1px dashed var(--gy300); padding:15px; border-radius:var(--rxl);">
                    @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                    {
                        <img src="@Model.PhotoUrl" alt="Foto" style="width:64px; height:64px; object-fit:cover; border-radius:50%; border:2px solid var(--gy300);" />
                    }
                    <div>
                        <p style="font-weight:600; color:var(--gy700); margin:0;">Foto Actualizada (Bloqueada)</p>
                        <p style="font-size:11px; color:var(--gy500); margin:0;">No se permite cambiar la foto de candidatos con historial electoral.</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row2">
                <div class="fw">
                    <label asp-for="Name" class="fl">Nombre <span class="req">*</span></label>
                    <input asp-for="Name" class="fi" type="text" required />
                    <span asp-validation-for="Name" style="font-size: 11px; color: var(--r400);"></span>
                </div>
                <div class="fw">
                    <label asp-for="LastName" class="fl">Apellido <span class="req">*</span></label>
                    <input asp-for="LastName" class="fi" type="text" required />
                    <span asp-validation-for="LastName" style="font-size: 11px; color: var(--r400);"></span>
                </div>
            </div>

            <div class="fw" style="margin-top: 1.25rem;">
                <label class="fl">Foto del Candidato</label>
                
                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <div style="display:flex; align-items:center; gap:15px; margin-bottom:12px; background:var(--gy50); padding:10px; border-radius:var(--rmd); border:1px solid var(--gy200);">
                        <img src="@Model.PhotoUrl" alt="Foto actual" style="width:48px; height:48px; object-fit:cover; border-radius:50%; border: 2px solid var(--gy300);" />
                        <div>
                            <p style="font-weight:500; font-size:12px; margin:0; color:var(--gy700)">Foto actual del candidato</p>
                            <p style="font-size:11px; margin:0; color:var(--gy500)">Suba un nuevo archivo si desea cambiarla.</p>
                        </div>
                    </div>
                }

                <div class="upz" id="uploadZone" onclick="document.getElementById('photoInput').click()">
                    <i class="ti ti-photo" id="uploadIcon"></i>
                    <p class="upm" id="uploadText">Arrastre una nueva foto aquí para reemplazarla</p>
                    <p class="ups" id="uploadSubtext">o haga clic para seleccionar (Máx: 2MB, JPG/PNG)</p>
                    <input type="file" id="photoInput" name="PhotoFile" style="display:none;" accept=".jpg,.jpeg,.png" />
                </div>
                <span asp-validation-for="PhotoFile" style="font-size: 11px; color: var(--r400);"></span>
            </div>
        }

        <div style="display:flex; gap:8px; margin-top:1.75rem">
            <button type="submit" class="fbtn" style="border: none; cursor: pointer; padding: 9px 18px; font-weight: 600; border-radius: var(--rmd); background: var(--g800); color: #fff; display: inline-flex; align-items: center; gap: 5px;">
                <i class="ti ti-check"></i> Guardar
            </button>
            <a href="@Url.Action("Index", "Candidate")" class="bo" style="text-decoration: none;">Cancelar</a>
        </div>
    </form>
</div>

@if (!participated)
{
    @section Scripts {
        <script>
            const input = document.getElementById('photoInput');
            const zone = document.getElementById('uploadZone');
            const text = document.getElementById('uploadText');
            const subtext = document.getElementById('uploadSubtext');
            const icon = document.getElementById('uploadIcon');

            input.addEventListener('change', function() {
                if (input.files && input.files[0]) {
                    const file = input.files[0];
                    text.textContent = file.name;
                    subtext.textContent = (file.size / 1024 / 1024).toFixed(2) + " MB";
                    icon.className = "ti ti-circle-check";
                    icon.style.color = "var(--g600)";
                }
            });

            // drag and drop events
            zone.addEventListener('dragover', e => {
                e.preventDefault();
                zone.style.background = "#d4e6f5";
            });
            zone.addEventListener('dragleave', () => {
                zone.style.background = "var(--b50)";
            });
            zone.addEventListener('drop', e => {
                e.preventDefault();
                zone.style.background = "var(--b50)";
                if (e.dataTransfer.files.length) {
                    input.files = e.dataTransfer.files;
                    const file = input.files[0];
                    text.textContent = file.name;
                    subtext.textContent = (file.size / 1024 / 1024).toFixed(2) + " MB";
                    icon.className = "ti ti-circle-check";
                    icon.style.color = "var(--g600)";
                }
            });
        </script>
    }
}

