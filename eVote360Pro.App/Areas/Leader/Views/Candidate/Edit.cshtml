@model eVote360Pro.Core.Application.ViewModels.Candidate.SaveCandidateViewModel
@{
    ViewData["Title"] = "Editar Candidato";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-warning text-dark py-3 border-0 d-flex align-items-center">
                    <h5 class="card-title fw-bold mb-0"><i class="bi bi-pencil-square me-2"></i> Editar Candidato</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="PoliticalPartyId" />
                        <input type="hidden" asp-for="PhotoUrl" />
                        <input type="hidden" asp-for="IsActive" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Nombre</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label fw-semibold">Apellido</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                        {
                            <div class="mb-3">
                                <label class="form-label d-block fw-semibold">Foto Actual</label>
                                <div class="bg-light rounded-circle p-1 border d-inline-block shadow-sm" style="width: 100px; height: 100px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                    <img src="@Model.PhotoUrl" alt="Foto actual" class="img-fluid rounded-circle" style="height: 100%; width: 100%; object-fit: cover;" />
                                </div>
                            </div>
                        }

                        <div class="mb-4">
                            <label asp-for="PhotoFile" class="form-label fw-semibold">Subir Nueva Foto (Opcional)</label>
                            <input asp-for="PhotoFile" class="form-control" type="file" accept="image/*" />
                            <span asp-validation-for="PhotoFile" class="text-danger small"></span>
                            <div class="form-text">Si no deseas cambiar la foto de perfil, deja este campo vacío.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning fw-semibold px-4 flex-grow-1">
                                <i class="bi bi-save-fill me-2"></i> Guardar Cambios
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
