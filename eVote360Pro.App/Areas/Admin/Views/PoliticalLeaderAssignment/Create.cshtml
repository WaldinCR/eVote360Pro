@model eVote360Pro.Core.Application.ViewModels.PoliticalLeaderAssignment.SavePoliticalLeaderAssignmentViewModel
@{
    ViewData["Title"] = "Asignar Dirigente";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-primary text-white py-3 border-0 d-flex align-items-center">
                    <h5 class="card-title fw-bold mb-0"><i class="bi bi-link me-2"></i> Asignar Dirigente a Partido</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="UserId" class="form-label fw-semibold">Dirigente Político Disponible</label>
                            <select asp-for="UserId" class="form-select" asp-items="@(new SelectList(ViewBag.AvailableLeaders ?? new List<eVote360Pro.Core.Application.Dtos.User.UserDto>(), "Id", "UserName"))">
                                <option value="">-- Seleccione un Dirigente --</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PoliticalPartyId" class="form-label fw-semibold">Partido Político Disponible</label>
                            <select asp-for="PoliticalPartyId" class="form-select" asp-items="@(new SelectList(ViewBag.AvailableParties ?? new List<eVote360Pro.Core.Application.ViewModels.PoliticalParty.PoliticalPartyViewModel>(), "Id", "Name"))">
                                <option value="">-- Seleccione un Partido --</option>
                            </select>
                            <span asp-validation-for="PoliticalPartyId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary fw-semibold px-4 flex-grow-1">
                                <i class="bi bi-check-circle-fill me-2"></i> Asignar
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
