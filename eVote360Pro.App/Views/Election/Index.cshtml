@using eVote360Pro.Core.Domain.Common.Enums
@model IEnumerable<eVote360Pro.Core.Application.ViewModels.Election.ElectionViewModel>
@{
    ViewData["Title"] = "Gestión de Elecciones";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold"><i class="bi bi-trophy-fill text-primary me-2"></i> Gestión de Elecciones</h2>
        <p class="text-muted">Motor principal del sistema. Controle el ciclo de vida de los procesos electorales.</p>
    </div>
    <div class="col-md-4 text-md-end align-self-center">
        @if (!Model.Any(e => e.Status == ElectionStatus.Active))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Nueva Elección
            </a>
        }
        else
        {
            <button class="btn btn-secondary shadow-sm" disabled title="No se pueden crear elecciones mientras haya una activa.">
                <i class="bi bi-plus-circle me-1"></i> Nueva Elección
            </button>
        }
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="ps-3">Nombre del Proceso</th>
                    <th class="text-center">Año Electoral</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center pe-3">Acciones / Resultados</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-5">
                            <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                            <p class="mb-0 fs-5">No hay elecciones registradas en el sistema.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr class="@(item.Status == ElectionStatus.Active ? "table-success" : "")">
                            <td class="ps-3 fw-bold @(item.Status == ElectionStatus.Active ? "text-success" : "")">
                                @item.Name
                            </td>
                            <td class="text-center fw-semibold">@item.Year</td>
                            <td class="text-center">
                                @if (item.Status == ElectionStatus.Pending)
                                {
                                    <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="bi bi-hourglass-split me-1"></i> Pendiente</span>
                                }
                                else if (item.Status == ElectionStatus.Active)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2 animate__animated animate__pulse animate__infinite"><i class="bi bi-broadcast me-1"></i> Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark rounded-pill px-3 py-2"><i class="bi bi-flag-fill me-1"></i> Finalizada</span>
                                }
                            </td>
                            <td class="text-center pe-3">
                                <div class="btn-group shadow-sm" role="group">
                                    
                                    @if (item.Status == ElectionStatus.Pending)
                                    {
                                        <form asp-action="Activate" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('ATENCIÓN: Al activar esta elección, el sistema bloqueará la creación/edición de ciudadanos, puestos y candidatos. ¿Desea proceder?');">
                                            <button type="submit" class="btn btn-sm btn-outline-success fw-bold" title="Activar Elección">
                                                <i class="bi bi-play-fill"></i> Activar
                                            </button>
                                        </form>
                                    }
                                    else if (item.Status == ElectionStatus.Active)
                                    {
                                        <form asp-action="Finish" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Está absolutamente seguro de finalizar esta elección? Esta acción es irreversible y calculará los resultados finales.');">
                                            <button type="submit" class="btn btn-sm btn-danger fw-bold" title="Finalizar Elección">
                                                <i class="bi bi-stop-circle-fill"></i> Finalizar
                                            </button>
                                        </form>
                                    }
                                    else if (item.Status == ElectionStatus.Finished)
                                    {
                                        <a asp-action="Results" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Ver Resultados">
                                            <i class="bi bi-bar-chart-fill"></i> Resultados
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>