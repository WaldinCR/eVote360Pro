@model eVote360Pro.Core.Application.ViewModels.Citizen.SaveCitizenViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Nuevo Ciudadano" : "Editar Ciudadano";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-person-vcard"></i> @ViewData["Title"]</h5>
            </div>
            <div class="card-body">
                <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="HasVoted" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label fw-bold"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="Nombres" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label fw-bold"></label>
                            <input asp-for="LastName" class="form-control" placeholder="Apellidos" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Document" class="form-label fw-bold"></label>
                            @if (Model.HasVoted)
                            {
                                <input asp-for="Document" class="form-control bg-light" readonly />
                                <small class="text-warning"><i class="bi bi-info-circle"></i> Bloqueado: El ciudadano ya ejerció su derecho al voto.</small>
                            }
                            else
                            {
                                <input asp-for="Document" class="form-control" placeholder="Ej. 001-0000000-1" />
                            }
                            <span asp-validation-for="Document" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="correo@ejemplo.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>