@model eVote360Pro.Core.Application.ViewModels.PoliticalParty.SavePoliticalPartyViewModel
@{
    ViewData["Title"] = "Nuevo Partido Político";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-primary text-white py-3 border-0 d-flex align-items-center">
                    <h5 class="card-title fw-bold mb-0"><i class="bi bi-plus-circle-fill me-2"></i> Registrar Nuevo Partido Político</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Ej. Partido de la Democracia Moderna" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Acronym" class="form-label fw-semibold"></label>
                            <input asp-for="Acronym" class="form-control" placeholder="Ej. PDM" />
                            <span asp-validation-for="Acronym" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe brevemente los ideales y metas del partido político..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="LogoFile" class="form-label fw-semibold"></label>
                            <input asp-for="LogoFile" class="form-control" type="file" accept="image/*" />
                            <span asp-validation-for="LogoFile" class="text-danger small"></span>
                            <div class="form-text">Carga el logo del partido en formato JPG, PNG o SVG.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary fw-semibold px-4 flex-grow-1">
                                <i class="bi bi-save-fill me-2"></i> Guardar
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
