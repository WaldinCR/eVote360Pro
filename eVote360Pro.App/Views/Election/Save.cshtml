@model eVote360Pro.Core.Application.ViewModels.Election.SaveElectionViewModel

@{
    ViewData["Title"] = "Registrar Elección";
}

<div class="atop">
    <p class="aptitle"><i class="ti ti-plus"></i> Nueva elección</p>
    <a href="@Url.Action("Index", "Election")" class="bo"><i class="ti ti-arrow-left"></i> Volver</a>
</div>

<div class="form-section" style="max-width: 600px; margin: 0 auto;">
    <p class="form-section-title"><i class="ti ti-edit"></i> Datos de la elección</p>
    
    <form method="post" action="@Url.Action("Create", "Election")">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="ae" style="margin-bottom: 1rem;"></div>

        <div class="fw">
            <label asp-for="Name" class="fl">Nombre de la Elección <span class="req">*</span></label>
            <input asp-for="Name" class="fi" type="text" placeholder="Ej. Elección General 2026" required />
            <span asp-validation-for="Name" style="font-size: 11px; color: var(--r400);"></span>
            <p class="fhint">Debe ser descriptivo y único.</p>
        </div>

        <div class="fw">
            <label asp-for="Year" class="fl">Año Electoral <span class="req">*</span></label>
            <input asp-for="Year" class="fi" type="number" min="2000" max="2100" required />
            <span asp-validation-for="Year" style="font-size: 11px; color: var(--r400);"></span>
            <p class="fhint">Año correspondiente a la votación.</p>
        </div>

        <div style="display:flex; gap:8px; margin-top:1.5rem">
            <button type="submit" class="fbtn" style="border: none; cursor: pointer; padding: 9px 18px; font-weight: 600; border-radius: var(--rmd); background: var(--g800); color: #fff; display: inline-flex; align-items: center; gap: 5px;">
                <i class="ti ti-check"></i> Guardar
            </button>
            <a href="@Url.Action("Index", "Election")" class="bo" style="text-decoration: none;">Cancelar</a>
        </div>
    </form>
</div>
