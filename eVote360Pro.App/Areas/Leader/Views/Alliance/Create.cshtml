@model eVote360Pro.Core.Application.ViewModels.Alliance.CreateAllianceRequestViewModel
@{
    ViewData["Title"] = "Solicitar Alianza";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-primary text-white py-3 border-0 d-flex align-items-center">
                    <h5 class="card-title fw-bold mb-0"><i class="bi bi-diagram-3 me-2"></i> Solicitar Alianza Política</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small">Selecciona un partido político activo para enviarle una solicitud de alianza. Una vez aceptada, podrán realizar postulaciones aliadas cruzadas.</p>
                    
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="ApplicantPartyId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="ReceiverPartyId" class="form-label fw-semibold">Partido Político Destinatario</label>
                            <select asp-for="ReceiverPartyId" class="form-select" asp-items="@(new SelectList(ViewBag.AvailableParties ?? new List<eVote360Pro.Core.Application.ViewModels.PoliticalParty.PoliticalPartyViewModel>(), "Id", "Name"))">
                                <option value="">-- Seleccione un Partido --</option>
                            </select>
                            <span asp-validation-for="ReceiverPartyId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary fw-semibold px-4 flex-grow-1">
                                <i class="bi bi-send-fill me-2"></i> Enviar Solicitud
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
