@model eVote360Pro.Core.Application.ViewModels.Candidate.SaveCandidateViewModel
@{
    ViewData["Title"] = "Nuevo Candidato";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-primary text-white py-3 border-0 d-flex align-items-center">
                    <h5 class="card-title fw-bold mb-0"><i class="bi bi-plus-circle-fill me-2"></i> Registrar Nuevo Candidato</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="PoliticalPartyId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Nombre</label>
                            <input asp-for="Name" class="form-control" placeholder="Ej. Juan" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label fw-semibold">Apellido</label>
                            <input asp-for="LastName" class="form-control" placeholder="Ej. Pérez" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PhotoFile" class="form-label fw-semibold">Foto de Perfil</label>
                            <input asp-for="PhotoFile" class="form-control" type="file" accept="image/*" />
                            <span asp-validation-for="PhotoFile" class="text-danger small"></span>
                            <div class="form-text">Carga una foto tipo pasaporte del candidato.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary fw-semibold px-4 flex-grow-1">
                                <i class="bi bi-save-fill me-2"></i> Guardar
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
