@model eVote360Pro.Core.Application.ViewModels.ElectivePosition.SaveElectivePositionViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Nuevo Puesto" : "Editar Puesto";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-person-badge"></i> @ViewData["Title"]</h5>
            </div>
            <div class="card-body">
                <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="HasParticipated" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        @if (Model.HasParticipated)
                        {
                            <input asp-for="Name" class="form-control bg-light" readonly />
                            <small class="text-warning"><i class="bi bi-info-circle"></i> No se puede editar el nombre porque el puesto ya participó en elecciones.</small>
                        }
                        else
                        {
                            <input asp-for="Name" class="form-control" placeholder="Ej. Presidente" />
                        }
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>