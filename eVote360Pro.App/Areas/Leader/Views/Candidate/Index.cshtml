@model List<eVote360Pro.Core.Application.ViewModels.Candidate.CandidateViewModel>
@{
    ViewData["Title"] = "Mis Candidatos";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 text-dark fw-bold mb-1"><i class="bi bi-people-fill text-primary"></i> Candidatos</h1>
            <p class="text-muted mb-0">Mantenimiento y administración de los candidatos de tu partido político.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i> Nuevo Candidato
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-person-video text-muted display-4 mb-3"></i>
                <h4 class="text-secondary fw-semibold">No hay candidatos registrados en tu partido</h4>
                <p class="text-muted">Crea un candidato para comenzar con el proceso de postulaciones.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var c in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm transition-hover">
                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="candidate-photo-wrapper me-3 bg-light rounded-circle shadow-sm border p-1" style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                    @if (!string.IsNullOrEmpty(c.PhotoUrl))
                                    {
                                        <img src="@c.PhotoUrl" alt="Foto de @c.Name" class="img-fluid rounded-circle" style="height: 100%; width: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-fill text-muted fs-1"></i>
                                    }
                                </div>
                                <div>
                                    <h5 class="card-title fw-bold text-dark mb-0">@c.Name @c.LastName</h5>
                                    <span class="text-muted small">@c.PoliticalPartyName</span>
                                </div>
                            </div>
                            
                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold px-2.5 py-1">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold px-2.5 py-1">Inactivo</span>
                                    }
                                </div>
                                
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-secondary btn-sm rounded" title="Editar candidato">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    
                                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <input type="hidden" name="currentStatus" value="@c.IsActive.ToString().ToLower()" />
                                        @if (c.IsActive)
                                        {
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded" title="Desactivar candidato">
                                                <i class="bi bi-person-dash"></i> Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-success btn-sm rounded" title="Activar candidato">
                                                <i class="bi bi-person-check"></i> Activar
                                            </button>
                                        }
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1) !important;
    }
</style>
