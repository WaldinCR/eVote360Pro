@model eVote360Pro.Core.Application.ViewModels.Leader.LeaderHomeViewModel
@{
    ViewData["Title"] = "Panel de Dirigente Político";
}

<div class="container py-4">
    <!-- Header -->
    <div class="mb-4">
        <h1 class="h2 text-dark fw-bold mb-1"><i class="bi bi-flag-fill text-primary"></i> Panel de Operaciones</h1>
        <p class="text-muted mb-0">Controla y supervisa los candidatos, postulaciones y alianzas de tu partido político.</p>
    </div>

    <!-- Cards de Métricas -->
    <div class="row g-4 mb-4">
        <!-- Candidatos del Partido -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm bg-primary text-white h-100 rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 fw-semibold text-uppercase mb-1 small">Tus Candidatos</h6>
                            <h2 class="fw-bold mb-0">@Model.TotalCandidates</h2>
                        </div>
                        <i class="bi bi-person-fill fs-1 opacity-50"></i>
                    </div>
                    <div class="mt-3 pt-2 border-top border-white-10 d-flex justify-content-between text-white-50 small">
                        <span>Activos: <strong>@Model.ActiveCandidates</strong></span>
                        <span>Inactivos: <strong>@Model.InactiveCandidates</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alianzas Vigentes -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm bg-success text-white h-100 rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 fw-semibold text-uppercase mb-1 small">Alianzas Vigentes</h6>
                            <h2 class="fw-bold mb-0">@Model.ActiveAlliances</h2>
                        </div>
                        <i class="bi bi-diagram-3-fill fs-1 opacity-50"></i>
                    </div>
                    <div class="mt-3 pt-2 border-top border-white-10 text-white-50 small">
                        <span>Alianzas activas del partido</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Solicitudes de Alianza Recibidas Pendientes -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm bg-warning text-dark h-100 rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-dark-50 fw-semibold text-uppercase mb-1 small">Solicitudes Pendientes</h6>
                            <h2 class="fw-bold mb-0">@Model.PendingAllianceRequests</h2>
                        </div>
                        <i class="bi bi-mailbox2 fs-1 opacity-50"></i>
                    </div>
                    <div class="mt-3 pt-2 border-top border-dark-10 text-dark-50 small">
                        <span>Solicitudes recibidas por responder</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Enlaces Rápidos / Acciones Frecuentes -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom-0">
            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-lightning-charge-fill text-warning me-2"></i> Acciones del Dirigente</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <a asp-controller="Candidate" asp-action="Index" class="btn btn-outline-primary w-100 py-3 rounded text-start shadow-xs">
                        <h6 class="fw-bold mb-1"><i class="bi bi-person-plus me-2"></i> Gestionar Candidatos</h6>
                        <small class="text-muted">Crear, editar o desactivar candidatos de tu partido.</small>
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-controller="CandidatePosition" asp-action="Index" class="btn btn-outline-success w-100 py-3 rounded text-start shadow-xs">
                        <h6 class="fw-bold mb-1"><i class="bi bi-person-check me-2"></i> Asignar Candidatos a Puestos</h6>
                        <small class="text-muted">Postular candidatos propios y aliados a puestos electivos.</small>
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-controller="Alliance" asp-action="Index" class="btn btn-outline-info w-100 py-3 rounded text-start shadow-xs">
                        <h6 class="fw-bold mb-1"><i class="bi bi-diagram-3 me-2"></i> Operar Alianzas</h6>
                        <small class="text-muted">Enviar solicitudes, responder recibidas y ver alianzas activas.</small>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
