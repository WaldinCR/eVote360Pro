@model eVote360Pro.Core.Application.ViewModels.Election.ElectionResultViewModel
@{
    ViewData["Title"] = "Resultados Oficiales";
}

<div class="row mb-4">
    <div class="col-md-10">
        <h2 class="fw-bold"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i> Resultados Oficiales</h2>
        <p class="text-muted">Proceso Electoral: <strong>@Model.ElectionName (@Model.Year)</strong></p>
    </div>
    <div class="col-md-2 text-md-end">
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>
</div>

@if (!Model.Positions.Any())
{
    <div class="alert alert-warning shadow-sm">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> No se registraron votos en los puestos de esta elección.
    </div>
}
else
{
    foreach (var position in Model.Positions)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-person-badge-fill me-2"></i> @position.PositionName</h5>
                <span class="badge bg-light text-dark fs-6">Total Votos: @position.TotalVotes</span>
            </div>
            <div class="card-body">
                
                @if (position.TotalVotes > 0)
                {
                    <div class="alert @(position.IsTie ? "alert-warning" : "alert-success") mb-4 border-0 shadow-sm">
                        <h6 class="mb-0 fw-bold">
                            @if (position.IsTie) { <i class="bi bi-arrow-left-right me-2"></i> } else { <i class="bi bi-trophy-fill me-2"></i> }
                            @(position.IsTie ? "Resultado:" : "Ganador:") @position.WinnerName
                        </h6>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Candidato</th>
                                <th>Partido</th>
                                <th class="text-end">Votos Obtenidos</th>
                                <th class="text-end" style="width: 35%;">Porcentaje</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var candidate in position.Candidates)
                            {
                                <tr>
                                    <td class="fw-semibold">@candidate.CandidateName</td>
                                    <td>
                                        @if (candidate.PartyName == "N/A")
                                        {
                                            <span class="badge bg-secondary">Ninguno</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@candidate.PartyName</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold fs-5">@candidate.Votes</td>
                                    <td class="text-end">
                                        <div class="d-flex align-items-center justify-content-end">
                                            <span class="me-3 fw-semibold">@candidate.Percentage%</span>
                                            <div class="progress" style="width: 150px; height: 10px;">
                                                <div class="progress-bar @(candidate.CandidateName == "Ninguno" ? "bg-secondary" : "bg-primary")" role="progressbar" style="width: @candidate.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%;" aria-valuenow="@candidate.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}